{
  "name": "@bling-sync/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').writeFileSync('dist/db/migrations/package.json', JSON.stringify({type:'commonjs'}))\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bootstrap": "tsx src/scripts/bootstrap.ts",
    "migrate:up": "tsx ../../node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m src/db/migrations",
    "migrate:down": "tsx ../../node_modules/node-pg-migrate/bin/node-pg-migrate.js down -m src/db/migrations"
  },
  "dependencies": {
    "bullmq": "5.12.12",
    "cookie-parser": "1.4.6",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "exceljs": "^4.4.0",
    "express": "4.19.2",
    "hash-wasm": "4.11.0",
    "ioredis": "5.4.1",
    "node-pg-migrate": "7.6.0",
    "pg": "8.13.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.7",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "20.16.10",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "pg-mem": "2.8.1",
    "supertest": "7.0.0",
    "tsx": "4.19.1",
    "typescript": "5.6.2",
    "vitest": "2.1.2"
  }
}
