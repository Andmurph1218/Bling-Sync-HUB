# App & Server
# Login local: npm run seed:admin
# cria admin@jhshopping.local com senha admin, só em NODE_ENV=development e só no Postgres localhost.
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
NEXT_PUBLIC_API_URL=http://localhost:3001

# PostgreSQL 16
POSTGRES_USER=bling_hub
POSTGRES_PASSWORD=bling_hub_dev
POSTGRES_DB=bling_sync_hub
POSTGRES_PORT=5432
DATABASE_URL=postgres://bling_hub:bling_hub_dev@localhost:5432/bling_sync_hub

# Redis 7 (cache e locks BullMQ — nunca credenciais OAuth)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Publicação em marketplace. Só "true" liga a chamada real. Qualquer outro valor simula.
ENABLE_LIVE_PUBLISHING=false

# Quando "true", um produto que chega a 100% num canal ativo entra sozinho na publish_queue.
# A chamada ao marketplace continua dependendo de ENABLE_LIVE_PUBLISHING.
AUTO_PUBLISH_ENABLED=false

# Auth & Sessão (Argon2id + cookie opaco com SHA-256 no banco)
SESSION_COOKIE_NAME=bling_hub_sid
SESSION_TTL_HOURS=24
SESSION_COOKIE_SECURE=false

# Obrigatória. 64 caracteres hex (32 bytes). Sem ela a API não inicia.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Não reutilize uma chave publicada. Trocar a chave impede ler os tokens já gravados.
OAUTH_ENCRYPTION_KEY=

# Bling ERP v3 — opcional. O HUB grava estas credenciais na tabela channel_app_credentials
# na primeira leitura, se ainda não houver linha. Um app novo é cadastrado em Integrações.
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_WEBHOOK_SECRET=

# Mercado Livre (MLB)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_WEBHOOK_SECRET=

# Nuvemshop
NS_CLIENT_ID=
NS_CLIENT_SECRET=
NS_WEBHOOK_SECRET=

# Endereço público fixo do HUB. Sem barra no final.
# O Bling recebe PUBLIC_BASE_URL/webhooks/bling
PUBLIC_BASE_URL=https://hub.jhshopping.com.br
