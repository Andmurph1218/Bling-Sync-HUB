# App & Server
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
NEXT_PUBLIC_API_URL=http://localhost:3001

# PostgreSQL 16
POSTGRES_USER=bling_hub
POSTGRES_PASSWORD=bling_hub_dev
POSTGRES_DB=bling_sync_hub
POSTGRES_PORT=5432
DATABASE_URL=postgres://bling_hub:bling_hub_dev@localhost:5432/bling_sync_hub

# Redis 7 (cache e locks BullMQ — nunca credenciais OAuth)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Auth & Sessão (Argon2id + cookie opaco com SHA-256 no banco)
SESSION_COOKIE_NAME=bling_hub_sid
SESSION_TTL_HOURS=24
SESSION_COOKIE_SECURE=false

# Chave de criptografia AES-256-GCM para oauth_tokens (32 bytes em hex = 64 caracteres)
OAUTH_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Bling ERP v3
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_WEBHOOK_SECRET=

# Mercado Livre (MLB)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_WEBHOOK_SECRET=

# Nuvemshop
NS_CLIENT_ID=
NS_CLIENT_SECRET=
NS_WEBHOOK_SECRET=
